APP_NAME="BSS-c15-Investment-System"
APP_ENV=production
APP_KEY=base64:<generate-with-php-artisan-key-generate>
APP_DEBUG=false
APP_URL=https://<your-app>.onrender.com
APP_TIMEZONE=Africa/Kampala

LOG_CHANNEL=stderr
LOG_LEVEL=error

# Aiven MySQL
DB_CONNECTION=mysql
DB_HOST=<your-aiven-mysql-host>
DB_PORT=<your-aiven-mysql-port>
DB_DATABASE=<your-db-name>
DB_USERNAME=<your-db-user>
DB_PASSWORD=<your-db-password>
DB_PERSISTENT=true
DB_CONNECT_TIMEOUT=5
DB_EMULATE_PREPARES=false

# Paste the full CA certificate content from Aiven Console > SSL certificates
AIVEN_CA_PEM="-----BEGIN CERTIFICATE-----
<paste-your-aiven-ca-cert-here>
-----END CERTIFICATE-----"
MYSQL_ATTR_SSL_VERIFY_SERVER_CERT=true

# Cloudflare R2
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=<r2-access-key-id>
AWS_SECRET_ACCESS_KEY=<r2-secret-access-key>
AWS_DEFAULT_REGION=auto
AWS_BUCKET=<r2-bucket-name>
AWS_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
AWS_URL=https://<account-id>.r2.cloudflarestorage.com/<r2-bucket-name>
AWS_USE_PATH_STYLE_ENDPOINT=true

# Storage (Render persistent disk mounted at /var/data)
UPLOADS_ROOT=/var/data/uploads
UPLOADS_URL=${APP_URL}/uploads
PUBLIC_DISK_DRIVER=s3

# Session & Cache (file drivers work on Render free plan)
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Queue
QUEUE_CONNECTION=database
AUDIT_QUEUE_ENABLED=false
AUDIT_LOG_GET_REQUESTS=true

# Cloudinary (optional — for profile pictures)
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>?secure=true

# Mail
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=<your-email>
MAIL_PASSWORD=<your-app-password>
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=<your-email>
MAIL_FROM_NAME="${APP_NAME}"

# BSS Configuration
BSS_SYSTEM_NAME="Business Support System"
BSS_CURRENCY=UGX
BSS_CURRENCY_SYMBOL=UGX
BSS_DATE_FORMAT=Y-m-d
BSS_TIME_FORMAT=H:i:s
BSS_PAGINATION_PER_PAGE=15
BSS_BILLING_CYCLE=monthly
BSS_GRACE_PERIOD_DAYS=7
BSS_FINANCIAL_CURRENCY=UGX
BSS_INTEREST_RATE=5.5
BSS_MIN_SAVINGS=50000
BSS_TRANSACTION_FEE=0.01
BSS_WITHDRAWAL_FEE=0.005
BSS_MAX_FILE_SIZE=2048
BSS_SESSION_TIMEOUT=30
